# 음악 생성 — Suno 게이트웨이 (선택)
# Suno 공식 셀프서비스 키는 아직 없어, sunoapi.org / AIMLAPI 같은 게이트웨이를 사용합니다.
# 키가 없으면 앱은 데모 오디오(Higgsfield sonilo_music)로 폴백합니다.
SUNO_API_KEY=
SUNO_API_BASE=https://api.sunoapi.org
# (선택) 비동기 콜백을 받을 경우
SUNO_CALLBACK_URL=

# 가사/편지 생성 — Anthropic Claude (선택)
# 키가 있으면 claude-opus-4-8 로 감정/상황에 맞는 가사·편지·프롬프트를 매번 새로 창작.
# 없으면 템플릿(무드 팔레트) 생성기로 폴백.
ANTHROPIC_API_KEY=

# 이메일 발송 — SMTP (선택). 있으면 음악편지를 실제 이메일로 보냄. 없으면 미리보기만.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# 서버 포트
PORT=4000
